<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="multiOS" Width="880" Height="680" MinWidth="730" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F5F5F7" FontFamily="Segoe UI"
        FontSize="14" Foreground="#38383E" WindowStyle="None" ResizeMode="CanResize">
  <Window.Resources>
    <SolidColorBrush x:Key="Label" Color="#38383E"/>
    <SolidColorBrush x:Key="Secondary" Color="#626269"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Separator" Color="#E2E2E7"/>
    <SolidColorBrush x:Key="Accent" Color="#0071E3"/>
    <SolidColorBrush x:Key="ControlFill" Color="#ECECF0"/>
    <SolidColorBrush x:Key="TitleHover" Color="#E4E4E9"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#A0A0A8"/>
    <ControlTemplate x:Key="ScrollTrackButton" TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ScrollBar">
          <Grid Width="12" Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Template="{StaticResource ScrollTrackButton}" Focusable="False"/></Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template><ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" Margin="3,2" CornerRadius="3" Background="{DynamicResource ScrollThumb}" Opacity="0.65"/>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="0.9"/></Trigger>
                      <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="1"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate></Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Template="{StaticResource ScrollTrackButton}" Focusable="False"/></Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
      <Setter Property="Foreground" Value="{DynamicResource Label}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.94"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.88"/><Setter TargetName="Plate" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value></Setter></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Plate" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HeaderAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="6,0,0,0"/>
    </Style>
    <Style x:Key="TitleFocus" TargetType="Control">
      <Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="8"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TitleControl" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="40"/><Setter Property="Height" Value="36"/>
      <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Background" Value="{DynamicResource ControlFill}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource TitleFocus}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Separator}"
                BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="{DynamicResource TitleHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.72"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource Label}"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Label}"/><Setter Property="BorderBrush" Value="{DynamicResource Separator}"/><Setter Property="Padding" Value="12"/></Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Label}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid MinHeight="44"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
          <ContentPresenter VerticalAlignment="Center"/>
          <Border x:Name="Track" Grid.Column="1" Width="40" Height="24" CornerRadius="12" Background="#86868B" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"><Ellipse.RenderTransform><TranslateTransform x:Name="ThumbPosition"/></Ellipse.RenderTransform></Ellipse>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#248A3D"/><Setter TargetName="Thumb" Property="RenderTransform"><Setter.Value><TranslateTransform X="16"/></Setter.Value></Setter></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource Separator}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Margin="24,0,18,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="BrandText" FontSize="22" VerticalAlignment="Center"><Run Text="multi" FontWeight="Normal"/><Run Text="OS" FontWeight="Medium"/></TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="MinimizeButton" Style="{StaticResource TitleControl}" ToolTip="Küçült"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;" FontSize="13"/></Button>
          <Button x:Name="CloseButton" Style="{StaticResource TitleControl}" ToolTip="Pencereyi kapat; uygulama tepside çalışır"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="14"/></Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,1,0" Padding="16,24,16,16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0">
              <TextBlock Text="YEREL BAĞLANTI" FontSize="10" Foreground="{DynamicResource Secondary}" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#86868B" Margin="0,0,8,0"/><TextBlock x:Name="SidebarStatus" Text="Başlatılıyor" FontSize="12"/></StackPanel>
              <TextBlock x:Name="NetworkLabel" FontSize="11" Foreground="{DynamicResource Secondary}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel>
              <Button x:Name="NavReceive" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal" Width="136"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" Margin="0,0,12,0"/><TextBlock Text="Gelen dosyalar"/></StackPanel></Button>
              <Button x:Name="NavClipboard" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal" Width="136"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xF0E3;" Margin="0,0,12,0"/><TextBlock Text="Pano"/></StackPanel></Button>
              <Button x:Name="NavSend" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal" Width="136"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE898;" Margin="0,0,12,0"/><TextBlock Text="iPhone'a gönder"/></StackPanel></Button>
              <Button x:Name="NavDevice" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal" Width="136"><Viewbox Width="16" Height="17" Margin="0,0,12,0" VerticalAlignment="Center"><Path Fill="{DynamicResource Label}" Data="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></Viewbox><TextBlock Text="iPhone"/></StackPanel></Button>
              <Button x:Name="NavSettings" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal" Width="136"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,12,0"/><TextBlock Text="Ayarlar"/></StackPanel></Button>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Padding="32,26,32,16">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
              <Button x:Name="ClearReceived" DockPanel.Dock="Right" Style="{StaticResource HeaderAction}" Background="Transparent" Content="Geçmişi temizle" ToolTip="Gelen dosya geçmişini temizle; dosyalar korunur"/>
              <Button x:Name="FolderButton" DockPanel.Dock="Right" Style="{StaticResource HeaderAction}" Content="Klasörü aç" ToolTip="Gelen dosyalar klasörünü aç"/>
              <TextBlock x:Name="PageTitle" Text="Gelen dosyalar" FontSize="26" FontWeight="Normal" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="PageSubtitle" Grid.Row="1" Text="iPhone'dan gelen fotoğraf ve dosyalar." Foreground="{DynamicResource Secondary}" Margin="0,0,0,22"/>
            <Grid Grid.Row="2">
              <Grid x:Name="ReceivePage">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ReceiveList"/></ScrollViewer>
                <StackPanel x:Name="ReceiveEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="330">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB9F;" FontSize="48" Foreground="#B6B6BD" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                  <TextBlock Text="İlk fotoğrafını bekliyor" FontSize="19" FontWeight="Normal" TextAlignment="Center"/>
                  <TextBlock Text="iPhone'unla aynı Wi-Fi ağına bağlan. QR kodu okutup açılan sayfadan dosya gönder." x:Name="EmptyDetail" Foreground="{DynamicResource Secondary}" TextAlignment="Center" Margin="0,10,0,22"/>
                  <Button x:Name="PairFromEmpty" Content="iPhone'u eşleştir" Background="{DynamicResource Accent}" Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <ScrollViewer x:Name="ClipboardPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Width="420" HorizontalAlignment="Left">
                  <TextBlock x:Name="ClipboardEmpty" Text="Panoda henüz bir metin veya görsel yok." Foreground="{DynamicResource Secondary}" Margin="0,4,0,0"/>
                  <TextBox x:Name="ClipboardText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="260" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
                  <Border x:Name="ClipboardImagePanel" Visibility="Collapsed" BorderBrush="{DynamicResource Separator}" BorderThickness="1" CornerRadius="10" Padding="12" Background="{DynamicResource ControlFill}">
                    <Image x:Name="ClipboardImage" MaxWidth="480" MaxHeight="280" Stretch="Uniform" HorizontalAlignment="Left"/>
                  </Border>
                  <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="CopyClipboard" Content="Metni kopyala" Visibility="Collapsed"/>
                    <Button x:Name="CopyClipboardImage" Content="Görseli kopyala" Visibility="Collapsed"/>
                    <Button x:Name="ClearClipboard" Content="Pano kaydını temizle" Background="Transparent" Visibility="Collapsed"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
              <Grid x:Name="SendPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="160"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="DropZone" Background="#F5F5F7" BorderBrush="{DynamicResource Separator}" BorderThickness="1" CornerRadius="10" AllowDrop="True">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE898;" FontSize="28" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <Button x:Name="ChooseFiles" Content="Dosya seç" Background="{DynamicResource Accent}" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="veya dosyaları buraya sürükleyip bırak" Foreground="{DynamicResource Secondary}" Margin="0,10,0,0" TextAlignment="Center"/>
                    <TextBlock x:Name="StageStatus" Text="" Foreground="{DynamicResource Secondary}" Margin="0,10,0,0" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
                <DockPanel Grid.Row="1" Margin="0,20,0,12"><Button x:Name="ClearOutbound" DockPanel.Dock="Right" Style="{StaticResource HeaderAction}" Background="Transparent" Content="Listeyi temizle" ToolTip="Gönderilecek dosyaları temizle"/><Button x:Name="OpenPairForSend" DockPanel.Dock="Right" Content="iPhone bağlantısı" MinHeight="32" Padding="10,4" Background="Transparent" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="SendCount" Text="İndirilmeye hazır" FontWeight="Medium" VerticalAlignment="Center"/></DockPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SendList"/></ScrollViewer>
              </Grid>
              <ScrollViewer x:Name="DevicePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" MaxWidth="400" Margin="0,6,0,0">
                  <Border Background="White" Padding="8" CornerRadius="8" BorderBrush="#E2E2E7" BorderThickness="1" HorizontalAlignment="Center"><Image x:Name="QrImage" Width="204" Height="204"/></Border>
                  <TextBlock Text="iPhone'unla okut" FontSize="20" FontWeight="Normal" TextAlignment="Center" Margin="0,14,0,8"/>
                  <TextBlock x:Name="PairDetail" Text="Aynı Wi-Fi ağındaki iPhone'unla QR kodu okut. Açılan sayfadan dosya gönderip alabilirsin." Foreground="{DynamicResource Secondary}" TextAlignment="Center" Margin="0,0,0,10"/>
                  <Button x:Name="CopyPair" Content="Bağlantıyı kopyala" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="PairAddress" Foreground="{DynamicResource Secondary}" FontSize="12" TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
              </ScrollViewer>
              <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="Uygulama" FontSize="12" Foreground="{DynamicResource Secondary}" Margin="0,0,0,12"/>
                  <CheckBox x:Name="AutoStart" Content="Windows açıldığında başlat" MinHeight="44" VerticalContentAlignment="Center"/>
                  <CheckBox x:Name="DarkTheme" Content="Koyu görünüm" MinHeight="44" VerticalContentAlignment="Center"/>
                  <Separator Margin="0,18" Background="{DynamicResource Separator}"/>
                  <TextBlock Text="Kayıt konumu" FontSize="12" Foreground="{DynamicResource Secondary}"/>
                  <TextBlock x:Name="DropPath" Margin="0,8,0,6"/>
                  <TextBlock Text="Yeni gelen dosyalar bu klasöre kaydedilir. Önceki dosyalar yerinde kalır."
                             FontSize="12" Foreground="{DynamicResource Secondary}" Margin="0,0,0,12"/>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="ChooseReceiveFolder" Content="Klasör seç" Margin="0,0,8,0"/>
                    <Button x:Name="SettingsFolder" Content="Klasörü aç" Margin="0,0,8,0" Background="Transparent"/>
                    <Button x:Name="ResetReceiveFolder" Content="Varsayılana dön" Background="Transparent"/>
                  </StackPanel>
                  <Separator Margin="0,18" Background="{DynamicResource Separator}"/>
                  <Grid Margin="0,0,0,4">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Hakkında" FontSize="12" Foreground="{DynamicResource Secondary}"/>
                      <TextBlock x:Name="VersionLabel" Foreground="{DynamicResource Secondary}" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border x:Name="Signature" Background="{DynamicResource Label}" Width="96" Height="50" Opacity="0.55" HorizontalAlignment="Right" AutomationProperties.Name="Arda Yeşilgül imzası"/>
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="2" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Padding="24,0">
        <DockPanel LastChildFill="True"><TextBlock x:Name="Feedback" MaxWidth="560" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
