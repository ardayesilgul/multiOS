{
  "name": "multios",
  "version": "0.2.0",
  "private": true,
  "description": "Native Windows app for local iPhone file sharing",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:silent": "node src/server.js --silent",
    "tray": "src\\native\\multios-tray.exe",
    "build:native": "powershell -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build:dist": "powershell -ExecutionPolicy Bypass -File scripts/build-dist.ps1",
    "install:shortcut": "powershell -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1",
    "test": "node tests/api.js",
    "test:ui": "node tests/phone-ui.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "multicast-dns": "^7.2.5",
    "qrcode": "^1.5.4"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
